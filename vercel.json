{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/en/",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/experience.html",
      "destination": "/experience",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/en/experience.html",
      "destination": "/en/experience",
      "permanent": true
    },
    {
      "source": "/(film|origin)",
      "destination": "/experience",
      "permanent": true
    },
    {
      "source": "/en/(film|origin)",
      "destination": "/en/experience",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/en/experience",
      "destination": "/en/experience.html"
    },
    {
      "source": "/experience",
      "destination": "/experience.html"
    },
    {
      "source": "/en/experience/(film|origin|product)",
      "destination": "/en/experience.html"
    },
    {
      "source": "/experience/(film|origin|product)",
      "destination": "/experience.html"
    },
    {
      "source": "/en/(why|grades|packing|product|gallery|shipping|faq|quote)",
      "destination": "/en/index.html"
    },
    {
      "source": "/(why|grades|packing|product|gallery|shipping|faq|quote)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
